#include "raven.dtsi"
#include "raven-pinctrl.dtsi"

&kscan0 {
    // Handwire: cathodes face the switches/rows, anodes face the columns.
    diode-direction = "col2row";
    // Physical rows, top to bottom.
    row-gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    // Physical columns, left to right.
    col-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>,
                <&gpio1 11 GPIO_ACTIVE_LOW>,
                <&gpio0 10 GPIO_ACTIVE_LOW>,
                <&gpio0 8  GPIO_ACTIVE_LOW>,
                <&gpio1 6  GPIO_ACTIVE_LOW>,
                <&gpio1 4  GPIO_ACTIVE_LOW>;
};

// Wake from soft off with F (row 1, column 4) on the handwired matrix.
&wakeup_key {
    gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&wakeup_trigger {
    extra-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
};

// P0.08 is now a matrix column, not a UART RX pin.
&uart0 {
    status = "disabled";
};

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        com-sequential;
        prechargep = <0x22>;
        inversion-on;
    };
};


zephyr_udc0: &usbd {
    status = "okay";
};


