#include "raven.dtsi"
#include "raven-pinctrl.dtsi"

// Physical 6-column x 4-row layout, viewed from the keycap side.
// Electrical columns run right to left; RC(0,0) is the top-right T key.
&default_transform {
    map = <
        RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
        RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
        RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
        RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
    >;
};

&kscan0 {
    // Scan direction follows the hardware test: drive P1.13, sense P0.31.
    // Reference T: switch pin 1 = P0.31; diode-side wire at pin 2 = P1.13.
    // Firmware row/column indices are independent of physical wire orientation.
    diode-direction = "row2col";
    // Firmware rows; remaining physical positions still need verification.
    row-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>,
                <&gpio0 29 GPIO_ACTIVE_HIGH>,
                <&gpio0 2  GPIO_ACTIVE_HIGH>,
                <&gpio1 15 GPIO_ACTIVE_HIGH>;

    // Electrical columns, right to left when viewed from the keycap side.
    col-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

// Wake from soft off with electrical row 1, column 4 (physical row 1, column 1).
&wakeup_key {
    gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

&wakeup_trigger {
    extra-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
};

// P0.08 is now a matrix column, not a UART RX pin.
&uart0 {
    status = "disabled";
};

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        com-sequential;
        prechargep = <0x22>;
        inversion-on;
    };
};


zephyr_udc0: &usbd {
    status = "okay";
};


