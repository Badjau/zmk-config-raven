// Select the shared handwire split keymap.
#define RAVEN_RIGHT_HANDWIRE 1

#include "raven.dtsi"
#include "raven-pinctrl.dtsi"

// Physical order from the keycap side: Y through Backspace, top to bottom.
&default_transform {
    columns = <12>;
    rows = <4>;
    col-offset = <6>;
    map = <
        RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
    >;
};

&kscan0 {
    // Same diode polarity as the left handwire: drive columns, sense rows.
    diode-direction = "col2row";
    // Y, H, N, Del rows.
    row-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    // Y, U, I, O, P, Backspace columns.
    col-gpios = <&gpio1 4  GPIO_ACTIVE_HIGH>,
                <&gpio0 9  GPIO_ACTIVE_HIGH>,
                <&gpio0 10 GPIO_ACTIVE_HIGH>,
                <&gpio1 11 GPIO_ACTIVE_HIGH>,
                <&gpio1 13 GPIO_ACTIVE_HIGH>,
                <&gpio1 15 GPIO_ACTIVE_HIGH>;
};

// Wake with J: drive P0.09, sense P1.00.
&wakeup_key {
    gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};
&wakeup_trigger {
    extra-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
};

// OLED SDA/SCL (P1.00/P0.11) are now matrix rows.
/ {
    chosen {
        /delete-property/ zephyr,display;
    };
};
&i2c0 {
    status = "disabled";
};

zephyr_udc0: &usbd {
    status = "okay";
};

/ {
    behaviors {
        hid_fwd: hid_fwd {
            compatible = "zmk,behavior-hid-fwd";
            #binding-cells = <0>;
        };
    };
};
